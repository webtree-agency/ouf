# Kopie als .env.local anlegen. Echte Werte nie committen.

APP_URL=http://localhost:3400

# `127.0.0.1`, nicht `localhost`: macOS löst `localhost` zuerst nach `::1` auf,
# und dort kann etwas anderes lauschen als die eigene Datenbank.
DATABASE_URL=postgres://ouf:ouf@127.0.0.1:5440/ouf
# Nur für Tests, wird bei jedem Lauf geleert.
DATABASE_URL_TEST=postgres://ouf:ouf@127.0.0.1:5441/ouf_test

# Salz für den IP-Hash im Rate-Limit.
IP_HASH_SALT=

# Schlüssel für das TOTP-Geheimnis (AES-256-GCM), mindestens 32 Zeichen.
# Ändern macht alle eingerichteten Code-Apps unbrauchbar.
TOTP_ENCRYPTION_KEY=

# Nur lokal: der Kurzweg „Lokal anmelden als …" (§8). In der Produktion leer.
DEV_LOGIN_EMAIL=

# Wer sich registrieren darf, durch Komma getrennt. Leer heisst: niemand.
SIGNUP_EMAILS=

# Diktat beim Erfassen (ENTSCHEIDE.md). Fehlt einer, gibt es den Knopf nicht.
ANTHROPIC_API_KEY=
CLOUDFLARE_AI_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
